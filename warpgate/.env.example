# Warpgate module environment. Production copy: /data/warpgate/config/.env
DATA_DIR=/data
WARPGATE_VERSION=0.30.4

# Clients connect to this FQDN (no scheme/port). Used in generated URLs and TLS cert.
WARPGATE_EXTERNAL_HOST=warpgate.example.internal

# Initial admin password. Required only on the very first start (empty is OK afterwards,
# but sync-warpgate.py needs the real one). Generate: openssl rand -base64 18
WARPGATE_ADMIN_PASSWORD=

# Listener binding. Default is loopback only; set the IDC-internal address to expose.
WARPGATE_BIND_ADDR=127.0.0.1
WARPGATE_SSH_PORT=2222
WARPGATE_HTTP_PORT=18888
WARPGATE_MYSQL_PORT=33306
WARPGATE_POSTGRES_PORT=55432

# Target SSH host key policy at first setup: prompt | auto-accept | auto-reject | ignore
WARPGATE_HOST_KEY_VERIFICATION=prompt

# sync-warpgate.py (run from an admin workstation / Semaphore)
WARPGATE_URL=https://127.0.0.1:18888
WARPGATE_ADMIN_USER=admin
# WARPGATE_INSECURE_TLS=true   # only while using the self-signed certificate
# WARPGATE_HOST_HEADER=        # set to WARPGATE_EXTERNAL_HOST when WARPGATE_URL uses an IP (session is bound to Host)
