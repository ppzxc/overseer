# OpenTelemetry Collector Contrib Configuration for Overseer Managed Host
# Ingests Node Exporter & Docker metrics, system logs, and forwards to Central OTLP Backend

receivers:
  # 1. Prometheus Scrape receiver for local Node Exporter
  prometheus:
    config:
      scrape_configs:
        - job_name: 'node-exporter-local'
          scrape_interval: 15s
          static_configs:
            - targets: ['127.0.0.1:{{ node_exporter_port }}']
{% if docker_metrics_enabled | default(false) | bool %}
        - job_name: 'docker-engine-local'
          scrape_interval: 15s
          static_configs:
            - targets: ['{{ docker_metrics_address | default("127.0.0.1:9323") }}']
{% endif %}

  # 2. Hostmetrics receiver for kernel & hardware stats
  hostmetrics:
    collection_interval: 30s
    scrapers:
      cpu:
      memory:
      disk:
      filesystem:
      load:
      network:

  # 3. Filelog receiver for critical system and audit logs (ISMS/ISMS-P Baseline)
  filelog/system:
    include:
{% for log_path in otel_system_logs | default([
  '/var/log/messages',
  '/var/log/syslog',
  '/var/log/secure',
  '/var/log/auth.log',
  '/var/log/sudo.log',
  '/var/log/audit/audit.log',
  '/var/log/cron*',
  '/var/log/fail2ban.log',
  '/var/log/dnf.log',
  '/var/log/yum.log',
  '/var/log/dpkg.log',
  '/var/log/firewalld'
]) %}
      - {{ log_path }}
{% endfor %}
    start_at: end
    retry_on_failure:
      enabled: true

  # 4. Standard OTLP ingestion for application containers/services
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

processors:
  memory_limiter:
    check_interval: 1s
    limit_percentage: 75
    spike_limit_percentage: 20

  batch:
    send_batch_size: 1024
    timeout: 1s

  resourcedetection:
    detectors: [env, system]
    timeout: 2s
    system:
      hostname_sources: [os]

exporters:
  otlp/backend:
    endpoint: "{{ otel_target_endpoint | default('127.0.0.1:4317') }}"
    tls:
      insecure: {{ otel_target_insecure | default(true) | bool | lower }}
{% if otel_target_headers is defined and otel_target_headers | length > 0 %}
    headers:
      {{ otel_target_headers | to_nice_yaml(indent=2) | indent(6) }}
{% elif otel_auth_header is defined and otel_auth_header | length > 0 %}
    headers:
      Authorization: "{{ otel_auth_header }}"
{% endif %}

service:
  pipelines:
    metrics:
      receivers: [prometheus, hostmetrics, otlp]
      processors: [memory_limiter, batch, resourcedetection]
      exporters: [otlp/backend]

    logs:
      receivers: [filelog/system, otlp]
      processors: [memory_limiter, batch, resourcedetection]
      exporters: [otlp/backend]

    traces:
      receivers: [otlp]
      processors: [memory_limiter, batch, resourcedetection]
      exporters: [otlp/backend]

  telemetry:
    logs:
      level: info
