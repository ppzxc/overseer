# OpenBao module environment. Production copy: /data/openbao/config/.env
DATA_DIR=/data
OPENBAO_COMPOSE_DIR=
OPENBAO_CONFIG_DIR=
OPENBAO_SCRIPTS_DIR=
CURRENT_UID=
CURRENT_GID=

# Seal configuration
SEAL_TYPE=local
# OPENBAO_SHAMIR_MODE=auto
# KEY_MANAGEMENT_PROFILE=manual

# Optional Google Cloud KMS seal
# GCP_PROJECT=
# GCP_REGION=asia-northeast3
# GCP_KEY_RING=overseer-keyring
# GCP_OPENBAO_KEY=openbao-seal-key
# GOOGLE_APPLICATION_CREDENTIALS=

BAO_ADDR=http://127.0.0.1:8200
BAO_DEV_ROOT_TOKEN_ID=root
