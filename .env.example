# ==============================================================================
# Overseer Control Plane Environment Variables Template
# Copy this file to .env and adjust sensitive credentials.
# ==============================================================================

# PostgreSQL Database (for Boundary)
POSTGRES_USER=boundary
POSTGRES_PASSWORD=boundarypassword
POSTGRES_DB=boundary

# Vault Configuration
VAULT_ADDR=http://127.0.0.1:8200
VAULT_DEV_ROOT_TOKEN_ID=root

# Boundary Controller Configuration
BOUNDARY_ADDR=http://127.0.0.1:9200
BOUNDARY_POSTGRES_URL=postgresql://boundary:boundarypassword@postgres:5432/boundary?sslmode=disable
