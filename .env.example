# ==============================================================================
# Overseer Control Plane Environment Variables Template
# Copy this file to .env and adjust sensitive credentials.
# ==============================================================================

# Centralized Host Storage Path (Default: /data)
DATA_DIR=/data

# ------------------------------------------------------------------------------
# KMS & Unseal Backend Selection: local | gcpkms
# ------------------------------------------------------------------------------
SEAL_TYPE=local

# ------------------------------------------------------------------------------
# Host Port Exposure & Bindings (0.0.0.0:<port>:<port> via compose.override.yml)
# ------------------------------------------------------------------------------
# EXPOSE_PORTS=true
# OPENBAO_PORT_BINDING=0.0.0.0:8200:8200
# BOUNDARY_CONTROLLER_API_PORT=0.0.0.0:9200:9200
# BOUNDARY_CONTROLLER_CLUSTER_PORT=0.0.0.0:9201:9201
# BOUNDARY_WORKER_PROXY_PORT=0.0.0.0:9202:9202
# SEMAPHORE_PORT_BINDING=0.0.0.0:3000:3000

# ------------------------------------------------------------------------------
# GCP Cloud KMS Configuration (Required only when SEAL_TYPE=gcpkms)
# ------------------------------------------------------------------------------
# GCP_PROJECT=
# GCP_REGION=asia-northeast3
# GCP_KEY_RING=overseer-keyring
# GCP_OPENBAO_KEY=openbao-seal-key
# GCP_BOUNDARY_ROOT_KEY=boundary-root-key
# GCP_BOUNDARY_WORKER_AUTH_KEY=boundary-worker-auth-key
# GCP_BOUNDARY_RECOVERY_KEY=boundary-recovery-key
# GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------------------------
# Key Management Mode (Optional / Advanced: auto | manual)
# ------------------------------------------------------------------------------
# OPENBAO_SHAMIR_MODE=auto
# BOUNDARY_AEAD_MODE=auto

# ------------------------------------------------------------------------------
# PostgreSQL Database (for Boundary & Semaphore)
# ------------------------------------------------------------------------------
POSTGRES_USER=boundary
POSTGRES_PASSWORD=boundarypassword
POSTGRES_DB=boundary

# ------------------------------------------------------------------------------
# OpenBao Configuration
# ------------------------------------------------------------------------------
BAO_ADDR=http://127.0.0.1:8200
BAO_DEV_ROOT_TOKEN_ID=root

# ------------------------------------------------------------------------------
# Boundary Controller & Worker Configuration
# ------------------------------------------------------------------------------
BOUNDARY_ADDR=http://127.0.0.1:9200
BOUNDARY_POSTGRES_URL=postgresql://boundary:boundarypassword@postgres:5432/boundary?sslmode=disable
BOUNDARY_KMS_AEAD_ROOT_KEY=sP191WKGvgcuEmhdREQBPBG5nhAAda4e+bQQnFRinCU=
BOUNDARY_KMS_AEAD_WORKER_AUTH_KEY=8pv7uU8g58aN8y1n8PqR8G3z7rW+V8eY9nQ2x3Z1v4U=
BOUNDARY_KMS_AEAD_RECOVERY_KEY=uK382WKGvgcuEmhdREQBPBG5nhAAda4e+bQQnFRinCU=

# ------------------------------------------------------------------------------
# Semaphore UI (Ansible Web UI) Configuration
# ------------------------------------------------------------------------------
SEMAPHORE_ADDR=http://127.0.0.1:3000
SEMAPHORE_DB=semaphore
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_NAME=Admin
SEMAPHORE_ADMIN_EMAIL=admin@overseer.local
SEMAPHORE_ADMIN_PASSWORD=semaphoreadmin
SEMAPHORE_ACCESS_KEY_ENCRYPTION=GS3py5Y8+GvF12x0fTfR18k2h4eE9W2d1C8N6Q8T4=0

# ------------------------------------------------------------------------------
# Node Provisioner GitOps Repository
# ------------------------------------------------------------------------------
ANSIBLE_REPO_URL=https://github.com/ppzxc/node-provisioner.git
ANSIBLE_REPO_BRANCH=main
