# ==============================================================================
# Overseer Control Plane Environment Variables Template
# Copy this file to .env and adjust sensitive credentials.
# ==============================================================================

# Centralized Host Storage Path (Default: /data)
DATA_DIR=/data

# ------------------------------------------------------------------------------
# KMS & Unseal Backend Selection: local | gcpkms
# ------------------------------------------------------------------------------
SEAL_TYPE=local

# ------------------------------------------------------------------------------
# Semaphore host port binding (OpenBao stays internal on backend network)
# ------------------------------------------------------------------------------
# EXPOSE_PORTS=true
# SEMAPHORE_PORT_BINDING=0.0.0.0:3000:3000

# ------------------------------------------------------------------------------
# GCP Cloud KMS Configuration (Required only when SEAL_TYPE=gcpkms)
# ------------------------------------------------------------------------------
# GCP_PROJECT=
# GCP_REGION=asia-northeast3
# GCP_KEY_RING=overseer-keyring
# GCP_OPENBAO_KEY=openbao-seal-key
# GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------------------------
# Key Management Mode (Optional / Advanced: auto | manual)
# ------------------------------------------------------------------------------
# OPENBAO_SHAMIR_MODE=auto

# ------------------------------------------------------------------------------
# OpenBao Configuration
# ------------------------------------------------------------------------------
BAO_ADDR=http://127.0.0.1:8200
BAO_DEV_ROOT_TOKEN_ID=root

# ------------------------------------------------------------------------------
# Semaphore UI (Ansible Web UI) Configuration
# ------------------------------------------------------------------------------
SEMAPHORE_ADDR=http://127.0.0.1:3000
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_NAME=Admin
SEMAPHORE_ADMIN_EMAIL=admin@overseer.local
SEMAPHORE_ADMIN_PASSWORD=semaphoreadmin
# Generate once for a new deployment; preserve the existing value when restoring/migrating.
#   head -c 32 /dev/urandom | base64
SEMAPHORE_ACCESS_KEY_ENCRYPTION=

# ------------------------------------------------------------------------------
# Node Provisioner GitOps Repository
# ------------------------------------------------------------------------------
ANSIBLE_REPO_URL=https://github.com/ppzxc/node-provisioner.git
ANSIBLE_REPO_BRANCH=main
